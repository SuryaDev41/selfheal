# Self-Healing Test Automation Framework - OpenAI Configuration
# Last Updated: October 2026

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# Set which LLM provider to use
# Options: anthropic, openai
LLM_PROVIDER=openai

# ============================================================================
# OPENAI API CONFIGURATION (for GPT models)
# ============================================================================

# Your OpenAI API Key
# Get it from: https://platform.openai.com/api-keys
# Keep this PRIVATE - never commit to version control!
OPENAI_API_KEY=


# Model to use (optional, can be set in config YAML)
# Options:
#   gpt-3.5-turbo  (RECOMMENDED - cheapest and fast)
#   gpt-4o         (Latest, balanced)
#   gpt-4-turbo    (More capable, more expensive)
#   gpt-4          (Most capable, most expensive - NOT RECOMMENDED)
# OPENAI_MODEL=gpt-3.5-turbo

# ============================================================================
# ANTHROPIC API CONFIGURATION (for Claude models)
# Optional - only needed if switching back to Anthropic
# ============================================================================

# Your Anthropic API Key (optional)
# Get it from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Test environment
# Options: prod, staging, dev
TEST_ENV=prod

# Application URL (overrides config YAML if set)
 APP_URL=https://www.automationexercise.com

# Test account credentials (if not in config)
 TEST_EMAIL=test1@automationexercise.com
 TEST_PASSWORD=Test@12345



# ============================================================================
# EXECUTION CONFIGURATION
# ============================================================================

# Browser mode
# Options: headless, headed
BROWSER_MODE=headed

# Browser type
# Options: chromium, firefox, webkit
BROWSER_TYPE=chromium

# Timeout settings (seconds)
STEP_TIMEOUT=30
LLM_TIMEOUT=30

# ============================================================================
# LOGGING & DEBUG
# ============================================================================

# Log level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Save screenshots
SCREENSHOT_ON_ERROR=true
SCREENSHOT_ON_PASS=true

# Debug mode (enables verbose logging)
DEBUG=false

# ============================================================================
# SAFETY & LIMITS
# ============================================================================

# Cost limit per run (USD)
MAX_COST_PER_RUN=1.00

# Token limit per run
MAX_TOKENS_PER_RUN=10000

# Enable headless (don't show browser)
HEADLESS=false 

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database path
DATABASE_PATH=data/store/elements.db

# Enable backups
DATABASE_BACKUP=true

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Delay between actions (milliseconds)
ACTION_DELAY_MS=100

# Enable request compression
COMPRESS_PAYLOADS=true

# Parallel execution
PARALLEL_STEPS=false
